<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MAC Movies</title>
    <style>
        :root {
            --bg-color: #141414;
            --card-bg: #2b2b2b;
            --text-main: #ffffff;
            --text-muted: #b3b3b3;
            --accent: #e50914; /* Netflix red */
        }
        
        body { 
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
            margin: 0; 
            padding: 0; 
            background-color: var(--bg-color); 
            color: var(--text-main);
        }

        /* Navbar */
        header {
            background-color: rgba(0, 0, 0, 0.9);
            padding: 20px 40px;
            display: flex;
            align-items: center;
            box-shadow: 0 4px 10px rgba(0,0,0,0.5);
            position: sticky;
            top: 0;
            z-index: 100;
        }
        header h1 {
            margin: 0;
            color: var(--accent);
            font-size: 2em;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        /* Main Content */
        .container {
            padding: 40px;
            max-width: 1400px;
            margin: 0 auto;
        }
        
        .section-title {
            margin-bottom: 30px;
            font-size: 1.5em;
            border-left: 4px solid var(--accent);
            padding-left: 10px;
        }

        /* Movie Grid */
        .movie-grid { 
            display: grid; 
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); 
            gap: 30px; 
        }

        /* Movie Card */
        .movie-card { 
            background-color: var(--card-bg); 
            border-radius: 10px; 
            overflow: hidden;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            cursor: pointer;
            display: flex; 
            flex-direction: column; 
            height: 100%;
        }
        .movie-card:hover {
            transform: translateY(-10px) scale(1.02);
            box-shadow: 0 15px 30px rgba(0,0,0,0.7);
        }

        /* Poster */
        .poster-container {
            position: relative;
            width: 100%;
            padding-top: 150%; /* 2:3 Aspect ratio for movie posters */
            overflow: hidden;
            background-color: #000;
        }
        .movie-poster { 
            position: absolute;
            top: 0;
            left: 0;
            width: 100%; 
            height: 100%; 
            object-fit: cover; 
        }

        /* Movie Details */
        .movie-details {
            padding: 20px;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
        }
        .movie-title { 
            font-size: 1.3em; 
            font-weight: bold; 
            margin-bottom: 10px; 
            line-height: 1.2;
        }
        .movie-meta { 
            display: flex;
            justify-content: space-between;
            color: var(--text-muted); 
            font-size: 0.9em;
            margin-bottom: 15px; 
            font-weight: 500;
        }
        .genre-badge {
            background-color: rgba(229, 9, 20, 0.2);
            color: var(--accent);
            padding: 3px 8px;
            border-radius: 4px;
            font-size: 0.85em;
        }
        .movie-description { 
            color: var(--text-muted); 
            font-size: 0.9em; 
            line-height: 1.5;
            display: -webkit-box;
            -webkit-line-clamp: 4;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
    </style>
</head>
<body>
    <header>
        <h1>MAC Movies</h1>
    </header>

    <div class="container">
        <div class="section-title">Trending Now</div>
        
        <div class="movie-grid">
            <% if (movies && movies.length > 0) { %>
                <% movies.forEach(function(movie) { %>
                    <div class="movie-card">
                        <div class="poster-container">
                            <% if (movie.image_url) { %>
                                <img src="<%= movie.image_url %>" alt="<%= movie.title %> Poster" class="movie-poster">
                            <% } else { %>
                                <img src="https://via.placeholder.com/300x450/2b2b2b/ffffff?text=No+Poster" alt="No Poster" class="movie-poster">
                            <% } %>
                        </div>
                        <div class="movie-details">
                            <div class="movie-title"><%= movie.title %></div>
                            <div class="movie-meta">
                                <span class="release-year"><%= movie.release_year %></span>
                                <span class="genre-badge"><%= movie.genre %></span>
                            </div>
                            <div class="movie-description"><%= movie.description %></div>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <p>No movies found. Please add some to your database!</p>
            <% } %>
        </div>
    </div>
</body>
</html>
